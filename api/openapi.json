        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Deployment tracking and the read-only query API of the VS Code extension.",
    "title": "TraceLens API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/commits/{sha}": {
      "get": {
        "operationId": "get_commit_commits__sha__get",
        "parameters": [
          {
            "in": "path",
            "name": "sha",
            "required": true,
            "schema": {
              "title": "Sha",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown commit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "A commit with the unified diff of each changed file"
      }
    },
    "/comparisons": {
      "get": {
        "operationId": "get_comparison_comparisons_get",
        "parameters": [
          {
            "description": "service.name, e.g. orders",
            "in": "query",
            "name": "service",
            "required": true,
            "schema": {
              "description": "service.name, e.g. orders",
              "minLength": 1,
              "title": "Service",
              "type": "string"
            }
          },
          {
            "description": "Baseline version (default: the one before `to`)",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Baseline version (default: the one before `to`)",
              "title": "From"
            }
          },
          {
            "description": "Version to analyze (default: the latest deployed)",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Version to analyze (default: the latest deployed)",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown deployment, or nothing indexed for its commit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compare two deployments of a service: regressions, SQL, errors, Evidence"
      }
    },
    "/deployments": {
      "get": {
        "operationId": "get_deployments_deployments_get",
        "parameters": [
          {
            "in": "query",
            "name": "service",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Service"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeploymentOut"
                  },
                  "title": "Response Get Deployments Deployments Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Registered deployments merged with versions seen in telemetry"
      },
      "post": {
        "operationId": "post_deployment_deployments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Already registered with the same commit"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Version already registered with a different commit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register which commit a service version was built from"
      }
    },
    "/endpoints": {
      "get": {
        "operationId": "get_endpoints_endpoints_get",
        "parameters": [
          {
            "in": "query",
            "name": "service",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Service"
            }
          },
          {
            "description": "e.g. 15m, 2h",
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "default": "15m",
              "description": "e.g. 15m, 2h",
              "pattern": "^\\d+[smhd]$",
              "title": "Window",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EndpointOut"
                  },
                  "title": "Response Get Endpoints Endpoints Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Endpoints seen recently"
      }
    },
    "/explanations": {
      "post": {
        "description": "The body is ONE Evidence document, the only thing a model sees. The answer is used only if every claim cites existing item IDs and states no number absent from the items it cites; a rejected answer is retried once, then replaced by a deterministic template, so the endpoint is useful with the LLM disabled (`source` says which).",
        "operationId": "post_explanation_explanations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "description": "An Evidence document",
                "title": "Body",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplanationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "Document too large"
          },
          "422": {
            "description": "Not a valid Evidence document"
          }
        },
        "summary": "Explain an Evidence document in words, every claim citing evidence IDs"
      }
    },
    "/queries/{fingerprint}": {
      "get": {
        "operationId": "get_query_queries__fingerprint__get",
        "parameters": [
          {
            "in": "path",
            "name": "fingerprint",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{16}$",
              "title": "Fingerprint",
              "type": "string"
            }
          },
          {
            "description": "service.name, e.g. orders",
            "in": "query",
            "name": "service",
            "required": true,
            "schema": {
              "description": "service.name, e.g. orders",
              "minLength": 1,
              "title": "Service",
              "type": "string"
            }
          },
          {
            "description": "Baseline version (default: the one before `to`)",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Baseline version (default: the one before `to`)",
              "title": "From"
            }
          },
          {
            "description": "Version to analyze (default: the latest deployed)",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Version to analyze (default: the latest deployed)",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such query in this comparison"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One SQL query: normalized text, code sites, per-endpoint change, plan"
      }
    },
    "/source": {
      "get": {
        "operationId": "get_source_source_get",
        "parameters": [
          {
            "in": "query",
            "name": "sha",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{7,40}$",
              "title": "Sha",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {}
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such file"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "A file's text at a commit (for side-by-side diffs in the editor)"
      }
    },
    "/symbols": {
      "get": {
        "operationId": "get_symbols_symbols_get",
        "parameters": [
          {
            "description": "service.name, e.g. orders",
            "in": "query",
            "name": "service",
            "required": true,
            "schema": {
              "description": "service.name, e.g. orders",
              "minLength": 1,
              "title": "Service",
              "type": "string"
            }
          },
          {
            "description": "Baseline version (default: the one before `to`)",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Baseline version (default: the one before `to`)",
              "title": "From"
            }
          },
          {
            "description": "Version to analyze (default: the latest deployed)",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Version to analyze (default: the latest deployed)",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SymbolLatencyOut"
                  },
                  "title": "Response Get Symbols Symbols Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Latency of every mapped symbol, for editor annotations (CodeLens)"
      }
    },
    "/traces/{trace_id}": {
      "get": {
        "operationId": "get_trace_traces__trace_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "trace_id",
            "required": true,
            "schema": {
              "title": "Trace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Trace not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "A trace as a waterfall: spans, critical-path time, code locations"
      }
    }
  }
}
