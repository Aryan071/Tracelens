{
  "components": {
    "schemas": {
      "DeploymentIn": {
        "additionalProperties": false,
        "properties": {
          "commitSha": {
            "examples": [
              "a1b2c3d4e5f6"
            ],
            "pattern": "^[0-9a-fA-F]{7,40}$",
            "title": "Commitsha",
            "type": "string"
          },
          "deployedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployedat"
          },
          "repo": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo"
          },
          "service": {
            "examples": [
              "orders"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Service",
            "type": "string"
          },
          "version": {
            "examples": [
              "2.18.4"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "commitSha"
        ],
        "title": "DeploymentIn",
        "type": "object"
      },
      "DeploymentOut": {
        "properties": {
          "commitSha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = seen in telemetry, not registered",
            "title": "Commitsha"
          },
          "deployedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployedat"
          },
          "firstSeen": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firstseen"
          },
          "lastSeen": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastseen"
          },
          "observed": {
            "title": "Observed",
            "type": "boolean"
          },
          "registered": {
            "title": "Registered",
            "type": "boolean"
          },
          "repo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "spans": {
            "title": "Spans",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "commitSha",
          "repo",
          "deployedAt",
          "firstSeen",
          "lastSeen",
          "spans",
          "registered",
          "observed"
        ],
        "title": "DeploymentOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Deployment tracking (Phase 4); query endpoints arrive in Phase 6.",
    "title": "TraceLens API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/deployments": {
      "get": {
        "operationId": "get_deployments_deployments_get",
        "parameters": [
          {
            "in": "query",
            "name": "service",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Service"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeploymentOut"
                  },
                  "title": "Response Get Deployments Deployments Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Registered deployments merged with versions seen in telemetry"
      },
      "post": {
        "operationId": "post_deployment_deployments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Already registered with the same commit"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Version already registered with a different commit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register which commit a service version was built from"
      }
    }
  }
}
