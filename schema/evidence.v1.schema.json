{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracelens.dev/schema/evidence.v1.schema.json",
  "title": "Evidence",
  "description": "A TraceLens diagnosis: a list of typed, linked, confidence-scored evidence items. Schema version 1.x is backward compatible within the major version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "generatedAt",
    "subject",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      }
    }
  },
  "$defs": {
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "HTTP method + route, e.g. 'POST /orders'."
        },
        "baselineDeployment": {
          "$ref": "#/$defs/DeploymentRef"
        },
        "currentDeployment": {
          "$ref": "#/$defs/DeploymentRef"
        }
      }
    },
    "DeploymentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "deployedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        },
        "codeLocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeLocation"
          }
        },
        "commitShas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          }
        },
        "queryFingerprints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CodeLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "LatencyStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "p50Ms",
        "p95Ms",
        "p99Ms"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "p50Ms": {
          "type": "number",
          "minimum": 0
        },
        "p95Ms": {
          "type": "number",
          "minimum": 0
        },
        "p99Ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "EvidenceItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/LatencyRegression"
        },
        {
          "$ref": "#/$defs/SpanAttribution"
        },
        {
          "$ref": "#/$defs/CommitChange"
        },
        {
          "$ref": "#/$defs/SqlChange"
        },
        {
          "$ref": "#/$defs/ErrorGroup"
        }
      ]
    },
    "LatencyRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "confidence",
        "links",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev_[a-z0-9_]+$",
          "description": "Stable, deterministic ID: derived from item type + subject keys, never random."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "type": {
          "const": "latency_regression"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "before",
            "after",
            "pValue",
            "effectSize",
            "test"
          ],
          "properties": {
            "target": {
              "type": "string",
              "description": "Endpoint or symbol the regression applies to."
            },
            "before": {
              "$ref": "#/$defs/LatencyStats"
            },
            "after": {
              "$ref": "#/$defs/LatencyStats"
            },
            "p95DeltaPct": {
              "type": "number"
            },
            "test": {
              "const": "mann_whitney_u"
            },
            "pValue": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Benjamini-Hochberg adjusted p-value (one-sided: after is slower)."
            },
            "effectSize": {
              "type": "number",
              "description": "Rank-biserial correlation in [-1, 1]."
            },
            "rawPValue": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Adjusted p-value without control normalization."
            },
            "commonLanguageEffect": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "P(random after-request is slower than a random before-request)."
            },
            "controlNormalization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shiftFactor",
                "controls"
              ],
              "properties": {
                "shiftFactor": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Multiplicative environment factor divided out of the after samples (1 = none)."
                },
                "controls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Endpoints with unchanged code used to estimate the factor."
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "title": "LatencyRegressionData"
        }
      }
    },
    "SpanAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "confidence",
        "links",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev_[a-z0-9_]+$",
          "description": "Stable, deterministic ID: derived from item type + subject keys, never random."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "type": {
          "const": "span_attribution"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "symbol",
            "mappingMethod",
            "mappingConfidence",
            "selfTimeBeforeMs",
            "selfTimeAfterMs",
            "shareOfIncrease"
          ],
          "properties": {
            "symbol": {
              "type": "string"
            },
            "mappingMethod": {
              "enum": [
                "semconv",
                "route_match",
                "route_name",
                "fuzzy_name"
              ]
            },
            "mappingConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "selfTimeBeforeMs": {
              "type": "number",
              "minimum": 0
            },
            "selfTimeAfterMs": {
              "type": "number",
              "minimum": 0
            },
            "shareOfIncrease": {
              "type": "number",
              "description": "Fraction of the endpoint's latency increase attributed to this symbol."
            },
            "onCriticalPath": {
              "type": "boolean"
            },
            "criticalTimeBeforeMs": {
              "type": "number",
              "minimum": 0,
              "description": "Mean critical-path time charged to the symbol per request, before."
            },
            "criticalTimeAfterMs": {
              "type": "number",
              "minimum": 0,
              "description": "Same, after (control-normalized when controlNormalization is present on the regression)."
            }
          },
          "title": "SpanAttributionData"
        }
      }
    },
    "CommitChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "confidence",
        "links",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev_[a-z0-9_]+$",
          "description": "Stable, deterministic ID: derived from item type + subject keys, never random."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "type": {
          "const": "commit_change"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha",
            "rank",
            "score",
            "changedSymbols",
            "reasons"
          ],
          "properties": {
            "sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "subject": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "rank": {
              "type": "integer",
              "minimum": 1
            },
            "score": {
              "type": "number",
              "minimum": 0
            },
            "changedSymbols": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "committedAt": {
              "type": "string",
              "format": "date-time"
            },
            "ambiguousWith": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$"
              },
              "description": "Other commits with an indistinguishable score (they changed the same hot symbols)."
            },
            "otherFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Changed non-source files that could not be tied to symbols."
            },
            "schemaChanges": {
              "type": "array",
              "description": "Database schema changes (DDL) in the commit that touch tables read by a regressed query.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "object",
                  "file"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "drop_index",
                      "create_index",
                      "alter_table",
                      "drop_table",
                      "create_table"
                    ]
                  },
                  "object": {
                    "type": "string",
                    "description": "Index or table the statement names."
                  },
                  "table": {
                    "type": "string",
                    "description": "Table affected, when known."
                  },
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "title": "CommitChangeData"
        }
      }
    },
    "SqlChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "confidence",
        "links",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev_[a-z0-9_]+$",
          "description": "Stable, deterministic ID: derived from item type + subject keys, never random."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "type": {
          "const": "sql_change"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fingerprint",
            "normalizedQuery",
            "before",
            "after"
          ],
          "properties": {
            "fingerprint": {
              "type": "string"
            },
            "normalizedQuery": {
              "type": "string"
            },
            "before": {
              "$ref": "#/$defs/LatencyStats"
            },
            "after": {
              "$ref": "#/$defs/LatencyStats"
            },
            "callCountBefore": {
              "type": "number",
              "minimum": 0,
              "description": "Mean calls per request; detects N+1."
            },
            "callCountAfter": {
              "type": "number",
              "minimum": 0
            },
            "explainPlanSummary": {
              "type": "string",
              "description": "Present only if EXPLAIN (never ANALYZE) was run on a configured replica."
            },
            "changeKind": {
              "type": "string",
              "enum": [
                "slower",
                "more_calls",
                "new"
              ],
              "description": "slower: each call takes longer (e.g. a plan change); more_calls: more calls per request (N+1); new: the query did not exist in the baseline."
            },
            "pValue": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Benjamini-Hochberg adjusted one-sided Mann-Whitney U p-value of time per request spent in this query."
            }
          },
          "title": "SqlChangeData"
        }
      }
    },
    "ErrorGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "confidence",
        "links",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev_[a-z0-9_]+$",
          "description": "Stable, deterministic ID: derived from item type + subject keys, never random."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "type": {
          "const": "error_group"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fingerprint",
            "exceptionType",
            "message",
            "count",
            "isNewInDeployment"
          ],
          "properties": {
            "fingerprint": {
              "type": "string"
            },
            "exceptionType": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "isNewInDeployment": {
              "type": "boolean"
            },
            "topFrame": {
              "$ref": "#/$defs/CodeLocation"
            },
            "baselineCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Occurrences of this error group in the baseline deployment."
            },
            "frames": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CodeLocation"
              },
              "description": "In-application stack frames, innermost first, resolved through source maps when available."
            },
            "mappingMethod": {
              "type": "string",
              "enum": [
                "source_map",
                "function_name",
                "none"
              ],
              "description": "How topFrame was tied to an indexed symbol."
            }
          },
          "title": "ErrorGroupData"
        }
      }
    }
  },
  "$comment": "Evidence schema 1.1.0. 1.1.0 is additive to 1.0.0: mappingMethod gains 'route_name'; optional fields were added to latency_regression, span_attribution and commit_change. Every 1.0.0 document remains valid."
}
